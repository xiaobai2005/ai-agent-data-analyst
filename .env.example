# ============ 环境变量示例 ============
# 用法：复制本文件为 .env 后填入真实密钥（.env 已在 .gitignore 中，不会被上传）
# 三个变量即可跑通：OPENAI_API_KEY / OPENAI_BASE_URL / MODEL

# ---- 方案 A：通义千问（DashScope 兼容 OpenAI 接口，中文场景推荐）----
OPENAI_API_KEY=sk-你的密钥
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen-plus
MODEL_PROVIDER=openai

# ---- 方案 B：DeepSeek ----
# OPENAI_API_KEY=sk-你的密钥
# OPENAI_BASE_URL=https://api.deepseek.com
# MODEL=deepseek-chat
# MODEL_PROVIDER=openai

# ---- 方案 C：OpenAI 官方 ----
# OPENAI_API_KEY=sk-你的密钥
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini
# MODEL_PROVIDER=openai

# ---- 可选：前端访问后端地址（部署到云端/容器时必填）----
# API_URL=http://127.0.0.1:8000
